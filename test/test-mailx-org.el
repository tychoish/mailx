;;; test-mailx-org.el --- Tests for mailx Org links -*- lexical-binding: t; -*-

;;; Commentary:
;; Tests for context-aware mail links.

;;; Code:

(require 'ert)
(require 'cl-lib)
(require 'mailx-org)

(dolist (dir (append '("/usr/share/emacs/site-lisp/mu4e")
                     (file-expand-wildcards "/usr/share/emacs/site-lisp/elpa-src/mu4e*")
                     (file-expand-wildcards "/usr/share/emacs/site-lisp/elpa/mu4e*")))
  (when (and (file-directory-p dir) (not (member dir load-path)))
    (add-to-list 'load-path dir)))

(require 'mu4e-context)

(defvar org-capture-templates nil)

(ert-deftest mailx-org-link-switches-before-search ()
  (let (events)
    (cl-letf (((symbol-function 'mailx-ensure-context)
               (lambda (name) (push (list 'context name) events)))
              ((symbol-function 'mu4e-search)
               (lambda (query) (push (list 'query query) events))))
      (mailx-org-follow-link "work%3Ateam:query:subject%3Ahello%20world" nil)
      (should (equal (nreverse events)
                     '((context "work:team") (query "subject:hello world")))))))

(ert-deftest mailx-org-link-opens-message-and-rejects-invalid ()
  (let (events)
    (cl-letf (((symbol-function 'mailx-ensure-context)
               (lambda (name) (push name events)))
              ((symbol-function 'mu4e-view-message-with-message-id)
               (lambda (id) (push id events))))
      (mailx-org-follow-link "work:msgid:%3Cid%40example.org%3E" nil)
      (should (equal events '("<id@example.org>" "work")))
      (should-error (mailx-org-follow-link "work:unknown:foo" nil)
                    :type 'user-error))))

(ert-deftest mailx-org-context-guards-and-readiness ()
  (let ((mailx--transitioning nil) (mailx-prepare-context-hook nil) events)
    (cl-letf (((symbol-function 'mu4e-context-current) (lambda () nil))
              ((symbol-function 'mailx-server--ensure-no-drafts)
               (lambda () (push 'guard events)))
              ((symbol-function 'mu4e-context-switch)
               (lambda (_force name) (push name events)))
              ((symbol-function 'mailx-server-ensure-ready)
               (lambda () (push 'ready events))))
      (mailx-ensure-context "work")
      (should (equal (nreverse events) '(guard "work" ready)))
      (let ((mailx--transitioning t))
        (should-error (mailx-ensure-context "work") :type 'user-error)))))

(ert-deftest mailx-org-stores-encoded-message-link ()
  (let ((major-mode 'mu4e-view-mode) stored)
    (cl-letf (((symbol-function 'mu4e-message-at-point)
               (lambda (&optional _) '(:message-id "<x@y>" :subject "Subject")))
              ((symbol-function 'mu4e-context-current)
               (lambda () (make-mu4e-context :name "work:team")))
              ((symbol-function 'org-link-store-props)
               (lambda (&rest props) (setq stored props))))
      (mailx-org-store-link)
      (should (equal (plist-get stored :link)
                     "mailx:work%3Ateam:msgid:%3Cx%40y%3E")))))

(defvar mailx-org-test-events nil)

(defun mailx-org-test-activate ()
  "Record context preparation."
  (push 'activate mailx-org-test-events))

(ert-deftest mailx-org-cold-start-loads-before-context-lookup ()
  (let ((mailx--transitioning nil)
        (mailx-org-test-events nil)
        (mailx-prepare-context-hook '(mailx-org-test-activate))
        (original-require (symbol-function 'require)))
    (cl-letf (((symbol-function 'require)
               (lambda (feature &rest args)
                 (if (memq feature '(mailx mu4e))
                     (push feature mailx-org-test-events)
                   (apply original-require feature args))))
              ((symbol-function 'mu4e-context-current)
               (lambda () (push 'lookup mailx-org-test-events) nil))
              ((symbol-function 'mailx-server--ensure-no-drafts) #'ignore)
              ((symbol-function 'mu4e-context-switch) #'ignore)
              ((symbol-function 'mailx-server-ensure-ready) #'ignore))
      (mailx-ensure-context "work")
      (should (equal (nreverse mailx-org-test-events) '(mailx activate mu4e lookup))))))

(ert-deftest mailx-org-setup-registers-link ()
  (let ((org-capture-templates '(("t" "tasks"))))
    (mailx-org-setup)
    (should (eq (org-link-get-parameter "mailx" :follow)
                #'mailx-org-follow-link))
    (should (eq (org-link-get-parameter "mailx" :store)
                #'mailx-org-store-link))
    (should (assoc "m" org-capture-templates))
    (mailx-org-teardown)
    (should-not (org-link-get-parameter "mailx" :follow))
    (should-not (assoc "m" org-capture-templates))))

(ert-deftest mailx-org-capture-task-flow ()
  (let ((major-mode 'mu4e-headers-mode)
        stored-link captured-key)
    (cl-letf (((symbol-function 'mu4e-message-at-point)
               (lambda (&optional _) '(:message-id "<msg@example.org>" :path "/tmp/fake" :subject "Task")))
              ((symbol-function 'mailx-org-store-link)
               (lambda () (setq stored-link t)))
              ((symbol-function 'org-capture)
               (lambda (_goto key) (setq captured-key key))))
      (mailx-capture-task "t")
      (should stored-link)
      (should (equal captured-key "t")))))

(ert-deftest mailx-org-sync-and-classify-async-skips-on-error ()
  (let ((classified nil) (finished nil)
        (fake-proc (make-pipe-process :name "fake" :buffer (generate-new-buffer " *fake*"))))
    (unwind-protect
        (cl-letf (((symbol-function 'make-process)
                   (lambda (&rest args)
                     (let ((sentinel (plist-get args :sentinel)))
                       (cl-letf (((symbol-function 'process-status) (lambda (&rest _) 'exit))
                                 ((symbol-function 'process-exit-status) (lambda (&rest _) 1)))
                         (funcall sentinel fake-proc "exited abnormally with code 1\n"))
                       fake-proc)))
                  ((symbol-function 'mailx-classify-batch)
                   (lambda (&rest _) (setq classified t))))
          (mailx-sync-and-classify-async "/tmp" "false" (lambda (_p _ev) (setq finished t)))
          (should finished)
          (should-not classified))
      (set-process-query-on-exit-flag fake-proc nil)
      (delete-process fake-proc)
      (when (buffer-live-p (process-buffer fake-proc))
        (kill-buffer (process-buffer fake-proc))))))

(provide 'test-mailx-org)
;;; test-mailx-org.el ends here
