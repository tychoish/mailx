;;; test-mailx-bulk.el --- Tests for mailx HITL targets -*- lexical-binding: t; -*-

;;; Commentary:
;; Tests use temporary files and a stubbed mu query; no mail is changed.

;;; Code:

(require 'ert)
(require 'cl-lib)
(require 'mailx-bulk)

(ert-deftest mailx-bulk-resolves-renamed-message-and-rejects-ambiguity ()
  (let* ((root (make-temp-file "mailx-bulk-" t))
         (path (expand-file-name "renamed" root))
         (target (list :root root :message-id "test@example.org" :path "old"))
         (message (list :message-id "test@example.org" :path path)))
    (unwind-protect
        (progn
          (write-region "test" nil path nil 'silent)
          (cl-letf (((symbol-function 'mailx--mu-find)
                     (lambda (_root _query) (list message))))
            (should (equal path (map-elt (mailx-bulk--resolve-target target) :path))))
          (cl-letf (((symbol-function 'mailx--mu-find)
                     (lambda (_root _query) (list message message))))
            (should-not (mailx-bulk--resolve-target target)))
          (cl-letf (((symbol-function 'mailx--mu-find)
                     (lambda (&rest _) (error "must not query"))))
            (should-not (mailx-bulk--resolve-target
                         (list :root root :message-id "x OR y")))))
      (delete-directory root t))))

(ert-deftest mailx-bulk-registration-and-operations ()
  (let ((domain (mailx-bulk-setup)))
    (should (hitl-plan-domain-struct-p domain))
    (should (eq (hitl-plan-domain-name domain) 'mailx))
    (should (hitl-plan-get-op 'mailx 'mark-read))
    (should (hitl-plan-get-op 'mailx 'refile))
    (should (hitl-plan-get-op 'mailx 'tag))
    (should (hitl-plan-get-op 'mailx 'unsubscribe))
    (should (hitl-plan-get-op 'mailx 'block-sender))
    (should (hitl-plan-get-op 'mailx 'expire-older))
    (should (hitl-plan-get-op 'mailx 'promote-rule))))

(ert-deftest mailx-bulk-visit-checks-database-and-revalidates ()
  (let* ((root (make-temp-file "mailx-bulk-" t))
         (home (expand-file-name ".mu" root))
         (path (expand-file-name "message" root))
         (target (list :root root :context "test" :message-id "a@example.org"))
         (message (list :path path :message-id "a@example.org"))
         (home-used home)
         (queries 0)
         (opened nil))
    (unwind-protect
        (progn
          (make-directory home)
          (write-region "test" nil path nil 'silent)
          (require 'mailx-org)
          (cl-letf (((symbol-function 'mailx--mu-find)
                     (lambda (&rest _) (setq queries (1+ queries)) (list message)))
                    ((symbol-function 'mailx-ensure-context) #'ignore)
                    ((symbol-function 'mailx-server-current-home) (lambda () home-used))
                    ((symbol-function 'mu4e-view-message-with-message-id)
                     (lambda (id) (setq opened id) nil)))
            (should (mailx-bulk--visit-target target))
            (should (= queries 2))
            (should (equal opened "a@example.org"))
            (setq opened nil)
            (setq home-used root)
            (should-error (mailx-bulk--visit-target target) :type 'user-error)
            (should-not opened)
            (should-error (mailx-bulk--visit-target
                           (list :root root :context "test" :message-id "a OR b"))
                          :type 'user-error)
            (should-not opened)))
      (delete-directory root t))))

(ert-deftest mailx-bulk-ensure-domain-registers-only-when-missing ()
  (let ((setups 0))
    (cl-letf (((symbol-function 'hitl-plan-get-domain) (lambda (_name) nil))
              ((symbol-function 'mailx-bulk-setup) (lambda () (setq setups (1+ setups)))))
      (mailx-bulk-ensure-domain)
      (should (= setups 1)))
    (setq setups 0)
    (cl-letf (((symbol-function 'hitl-plan-get-domain) (lambda (_name) 'registered))
              ((symbol-function 'mailx-bulk-setup) (lambda () (setq setups (1+ setups)))))
      (mailx-bulk-ensure-domain)
      (should (= setups 0)))))

(ert-deftest mailx-bulk-mcp-staging-registers-domain-first ()
  (require 'mailx-mcp)
  (let ((order nil))
    (cl-letf (((symbol-function 'mailx-mcp--root) (lambda (root) root))
              ((symbol-function 'mailx-bulk-ensure-domain)
               (lambda () (push 'ensure order)))
              ((symbol-function 'hitl-plan-create)
               (lambda (&rest _) (push 'create order) 'plan)))
      (mailx-mcp--stage-triage-plan "/tmp" "t" '((:message_id "a@b")))
      (should (equal (reverse order) '(ensure create))))))

(ert-deftest mailx-bulk-classify-op-stamps-and-moves-resolved-target ()
  (mailx-bulk-setup)
  (should (hitl-plan-get-op 'mailx 'classify))
  (let ((hitl-plan-current-target '(:root "/mail" :message-id "a@b"))
        (call nil))
    (cl-letf (((symbol-function 'mailx-bulk--resolve-target)
               (lambda (_target) '(:path "/mail/inbox/new/m")))
              ((symbol-function 'mailx-stamp-and-move)
               (lambda (&rest args) (setq call args))))
      (mailx-bulk--classify-apply 'read '("x") "/archive")
      (should (equal call '("/mail/inbox/new/m" "/mail" "/archive" read ("x") exclusive-access))))))

(ert-deftest mailx-bulk-apply-ops-fail-on-unresolvable-target ()
  "An unresolvable target must fail the step, not report it done."
  (let ((hitl-plan-current-target '(:root "/mail" :message-id "a@b")))
    (cl-letf (((symbol-function 'mailx-bulk--resolve-target) (lambda (_target) nil))
              ((symbol-function 'mailx-stamp-and-move)
               (lambda (&rest _) (error "must not move")))
              ((symbol-function 'mailx-rules-save)
               (lambda (&rest _) (error "must not save"))))
      (seq-do (lambda (thunk)
                (let ((err (should-error (funcall thunk))))
                  (should (string-match-p "no longer resolves" (error-message-string err)))))
              (list (lambda () (mailx-bulk--classify-apply 'read nil "/archive"))
                    (lambda () (mailx-bulk--tag-apply 'read nil))
                    (lambda () (mailx-bulk--refile-apply "/archive"))
                    (lambda () (mailx-bulk--mark-read-apply))
                    (lambda () (mailx-bulk--unsubscribe-apply))
                    (lambda () (mailx-bulk--block-sender-apply))
                    (lambda () (mailx-bulk--expire-apply 1)))))))

(ert-deftest mailx-bulk-promote-rule-saves-into-an-empty-rule-set ()
  (let ((hitl-plan-current-target '(:root "/mail" :message-id "a@b"))
        (rule (make-mailx-rule :id 'r :match '(:subject "x") :tier 'read))
        (saved 'unset))
    (cl-letf (((symbol-function 'mailx-rules-load) (lambda (&rest _) nil))
              ((symbol-function 'mailx-rules-save)
               (lambda (_root rules) (setq saved rules))))
      (mailx-bulk--promote-rule-apply rule))
    (should (equal saved (list rule)))))

(defun test-mailx-bulk--block (root sender moves)
  "Apply block-sender for SENDER under ROOT, recording moves in MOVES."
  (let ((hitl-plan-current-target (list :root root :message-id "a@b")))
    (write-region "x" nil (expand-file-name "m" root) nil 'silent)
    (cl-letf (((symbol-function 'mailx-bulk--resolve-target)
               (lambda (_target) (list :path (expand-file-name "m" root) :from sender)))
              ((symbol-function 'mailx-bulk--refile-apply)
               (lambda (folder) (push folder (car moves)))))
      (mailx-bulk--block-sender-apply))))

(ert-deftest mailx-bulk-block-sender-exact-address-no-duplicates ()
  (let ((root (make-temp-file "mailx-bulk-" t))
        (moves (list nil)))
    (unwind-protect
        (progn
          (test-mailx-bulk--block root "Bob <bob@gmail.com>" moves)
          (test-mailx-bulk--block root "Bob <bob@gmail.com>" moves)
          (let ((rules (mailx-rules-load root t)))
            (should (= 1 (length rules)))
            (should (mailx-eval-condition (mailx-rule-match (car rules))
                                          '(:from "bob@gmail.com")))
            (should (mailx-eval-condition (mailx-rule-match (car rules))
                                          '(:from ("Bob" . "bob@gmail.com"))))
            (should-not (mailx-eval-condition (mailx-rule-match (car rules))
                                              '(:from "alice@gmail.com")))
            (should-not (mailx-eval-condition (mailx-rule-match (car rules))
                                              '(:from "xbob@gmail.com"))))
          ;; The message is still trashed on the second apply.
          (should (= 2 (length (car moves)))))
      (delete-directory root t))))

(ert-deftest mailx-bulk-check-folder-validates ()
  (seq-do (lambda (bad)
            (should-error (mailx-bulk-check-folder bad) :type 'user-error))
          (list "/../escaped" "/a/../b" "//abs" "" "/a//b" "no-slash"
                "/a\nb" "/a\0b" nil 5))
  (should (equal "/archive/sub" (mailx-bulk-check-folder "/archive/sub"))))

(ert-deftest mailx-bulk-refile-rejects-escape-and-never-overwrites ()
  (let* ((top (make-temp-file "mailx-bulk-" t))
         (root (expand-file-name "root" top))
         (src (expand-file-name "inbox/cur/m1" root))
         (hitl-plan-current-target (list :root root :message-id "a@b")))
    (unwind-protect
        (progn
          (make-directory (file-name-directory src) t)
          (write-region "new" nil src nil 'silent)
          (cl-letf (((symbol-function 'mailx-bulk--resolve-target)
                     (lambda (_target) (list :path src))))
            (should-error (mailx-bulk--refile-apply "/../escaped") :type 'user-error)
            (should-not (file-exists-p (expand-file-name "escaped" top)))
            (make-directory (expand-file-name "dest/cur" root) t)
            (write-region "old" nil (expand-file-name "dest/cur/m1" root) nil 'silent)
            (should-error (mailx-bulk--refile-apply "/dest"))
            (should (equal "old" (with-temp-buffer
                                   (insert-file-contents (expand-file-name "dest/cur/m1" root))
                                   (buffer-string))))
            (should (file-exists-p src))
            (mailx-bulk--refile-apply "/archive/sub")
            (should (file-exists-p (expand-file-name "archive/sub/cur/m1" root)))))
      (delete-directory top t))))

(ert-deftest mailx-bulk-resolves-ids-with-formerly-rejected-characters ()
  (let* ((root (make-temp-file "mailx-bulk-" t))
         (path (expand-file-name "m" root))
         (queries nil))
    (unwind-protect
        (progn
          (write-region "x" nil path nil 'silent)
          (seq-do
           (lambda (id)
             (cl-letf (((symbol-function 'mailx--mu-find)
                        (lambda (_root query) (push query queries)
                          (list (list :message-id id :path path)))))
               (should (mailx-bulk-message-id-valid-p id))
               (should (mailx-bulk--resolve-target
                        (list :root root :message-id id)))))
           (list "a/b$c@x" "a!b#c&d~e'f@x" "q\"uote@x" "back\\slash@x"))
          (should (equal (car queries) "msgid:\"back\\\\slash@x\""))
          (should (member "msgid:\"q\\\"uote@x\"" queries))
          (should (member "msgid:\"a/b$c@x\"" queries)))
      (delete-directory root t))))

(ert-deftest mailx-bulk-message-id-validity-and-ambiguity ()
  (should-not (mailx-bulk-message-id-valid-p "a\nb@x"))
  (should-not (mailx-bulk-message-id-valid-p "a\0b@x"))
  (should-not (mailx-bulk-message-id-valid-p ""))
  (should-not (mailx-bulk-message-id-valid-p nil))
  (should-not (mailx-bulk-message-id-valid-p "x OR y"))
  (let* ((root (make-temp-file "mailx-bulk-" t))
         (path (expand-file-name "m" root))
         (msg (list :message-id "a/b@x" :path path)))
    (unwind-protect
        (progn
          (write-region "x" nil path nil 'silent)
          (cl-letf (((symbol-function 'mailx--mu-find)
                     (lambda (&rest _) (list msg msg))))
            (should-not (mailx-bulk--resolve-target
                         (list :root root :message-id "a/b@x")))))
      (delete-directory root t)))
  (mailx-bulk-setup)
  (should (hitl-plan-domain-unresolved-message (hitl-plan-get-domain 'mailx))))

(provide 'test-mailx-bulk)
